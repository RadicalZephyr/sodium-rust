diff --git a/src/impl_/counting_lock.rs b/src/impl_/counting_lock.rs
new file mode 100644
index 0000000..9d60e41
--- /dev/null
+++ b/src/impl_/counting_lock.rs
@@ -0,0 +1,53 @@
+//! A measurement device: parking_lot wrappers that count acquisitions,
+//! split between the propagation phase and the cycle collector.
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+
+pub static IN_COLLECTOR: AtomicBool = AtomicBool::new(false);
+pub static COUNTING: AtomicBool = AtomicBool::new(false);
+pub static PROPAGATION: AtomicUsize = AtomicUsize::new(0);
+pub static COLLECTOR: AtomicUsize = AtomicUsize::new(0);
+
+#[inline]
+fn tick() {
+    if COUNTING.load(Ordering::Relaxed) {
+        if IN_COLLECTOR.load(Ordering::Relaxed) {
+            COLLECTOR.fetch_add(1, Ordering::Relaxed);
+        } else {
+            PROPAGATION.fetch_add(1, Ordering::Relaxed);
+        }
+    }
+}
+
+pub struct Mutex<T: ?Sized>(parking_lot::Mutex<T>);
+
+impl<T> Mutex<T> {
+    pub fn new(v: T) -> Self {
+        Mutex(parking_lot::Mutex::new(v))
+    }
+}
+
+impl<T: ?Sized> Mutex<T> {
+    pub fn lock(&self) -> parking_lot::MutexGuard<'_, T> {
+        tick();
+        self.0.lock()
+    }
+}
+
+pub struct RwLock<T: ?Sized>(parking_lot::RwLock<T>);
+
+impl<T> RwLock<T> {
+    pub fn new(v: T) -> Self {
+        RwLock(parking_lot::RwLock::new(v))
+    }
+}
+
+impl<T: ?Sized> RwLock<T> {
+    pub fn read(&self) -> parking_lot::RwLockReadGuard<'_, T> {
+        tick();
+        self.0.read()
+    }
+    pub fn write(&self) -> parking_lot::RwLockWriteGuard<'_, T> {
+        tick();
+        self.0.write()
+    }
+}
