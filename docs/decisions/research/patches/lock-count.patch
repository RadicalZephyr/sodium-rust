diff --git a/docs/decisions/research/src/bin/0002-lock-count.rs b/docs/decisions/research/src/bin/0002-lock-count.rs
new file mode 100644
index 0000000..6227f73
--- /dev/null
+++ b/docs/decisions/research/src/bin/0002-lock-count.rs
@@ -0,0 +1,70 @@
+//! How many locks one `send` acquires, and which phase acquires them.
+//!
+//! This binary travels with `patches/lock-count.patch` rather than living in
+//! `src/bin/`, because it reads `sodium_rust::lock_counters` -- a counter that
+//! patch introduces. A binary here that does not compile against the unpatched
+//! library would break `cargo test --workspace`.
+//!
+//! ```shell
+//! git apply docs/decisions/research/patches/lock-count.patch
+//! cargo run --release -p adr-research --bin 0002-lock-count
+//! git apply -R docs/decisions/research/patches/lock-count.patch
+//! ```
+//!
+//! The split between propagation and the collector is the point. ADR-0002
+//! quotes it to explain why a token scoped to the cycle collector alone would
+//! collect most of the lock traffic but only a third of the win.
+
+use std::hint::black_box;
+use std::sync::atomic::Ordering;
+
+use sodium_rust::{lock_counters, SodiumCtx, Stream, StreamSink};
+
+fn main() {
+    println!(
+        "{:<8} {:>8} {:>13} {:>13} {:>13} {:>15}",
+        "depth", "updated", "locks/send", "propagation", "collector", "locks/update"
+    );
+
+    for depth in [1usize, 4, 16, 64] {
+        let updated = depth + 2;
+        let ctx = SodiumCtx::new();
+        let sink: StreamSink<i32> = ctx.new_stream_sink();
+        let mut stream: Stream<i32> = sink.stream();
+        for _ in 0..depth {
+            stream = stream.map(|a: &i32| a.wrapping_add(1));
+        }
+        let _listener = stream.listen(|a: &i32| {
+            black_box(a);
+        });
+
+        // Warm up: the first sends build up the collector's root buffer, and
+        // we want the steady state.
+        for i in 0..200 {
+            sink.send(black_box(i));
+        }
+
+        lock_counters::PROPAGATION.store(0, Ordering::Relaxed);
+        lock_counters::COLLECTOR.store(0, Ordering::Relaxed);
+        lock_counters::COUNTING.store(true, Ordering::Relaxed);
+        let sends = 200u64;
+        for i in 0..sends {
+            sink.send(black_box(i as i32));
+        }
+        lock_counters::COUNTING.store(false, Ordering::Relaxed);
+
+        let propagation = lock_counters::PROPAGATION.load(Ordering::Relaxed) as f64 / sends as f64;
+        let collector = lock_counters::COLLECTOR.load(Ordering::Relaxed) as f64 / sends as f64;
+        let total = propagation + collector;
+
+        println!(
+            "{:<8} {:>8} {:>13.1} {:>13.1} {:>13.1} {:>15.1}",
+            depth,
+            updated,
+            total,
+            propagation,
+            collector,
+            total / updated as f64
+        );
+    }
+}
